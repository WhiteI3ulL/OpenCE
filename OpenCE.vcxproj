<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>15.0</VCProjectVersion>
    <ProjectGuid>{5FDDE539-E51E-4EBF-A5AD-BD59D656DB5E}</ProjectGuid>
    <Keyword>MakeFileProj</Keyword>
    <RootNamespace>OpenCE</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- Set this to the include directory containing SDL3 includes. -->
    <OpenCESdlIncludeDir>$(ProjectDir)build\windows\third_party\SDL3-3.4.16\include</OpenCESdlIncludeDir>
    <OpenCEIncludeDirs>
      $(ProjectDir)port\include;
      $(ProjectDir)port\include\xdk;
      $(ProjectDir)port\linux\src;
      $(ProjectDir)port\windows\include\posix;
      $(ProjectDir)port\windows\include;
      $(ProjectDir)source;
      $(ProjectDir)tools\harness\include
    </OpenCEIncludeDirs>
    <OpenCEIncludeDirs Condition="'$(OpenCESdlIncludeDir)'!=''">
      $(OpenCEIncludeDirs);
      $(OpenCESdlIncludeDir)
    </OpenCEIncludeDirs>
    <!-- Populate from the real compiler command, not the Console template. -->
    <OpenCEDefines></OpenCEDefines>
    <!-- IDE workaround: load UCRT time types before POSIX wrappers. -->
    <OpenCEUcrtTimeHeader>
      C:\Program Files (x86)\Windows Kits\10\Include\10.0.26100.0\ucrt\time.h
    </OpenCEUcrtTimeHeader>
    <NMakeForcedIncludes>$(OpenCEUcrtTimeHeader);$(NMakeForcedIncludes)</NMakeForcedIncludes>
    <NMakeBuildCommandLine>
      echo IDE-only project: build using the existing PowerShell script.
    </NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>
      echo IDE-only project: rebuild using the existing PowerShell script.
    </NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>
      echo IDE-only project: clean using the existing PowerShell script.
    </NMakeCleanCommandLine>
    <NMakeIncludeSearchPath>$(OpenCEIncludeDirs);$(NMakeIncludeSearchPath)</NMakeIncludeSearchPath>
    <NMakePreprocessorDefinitions>$(OpenCEDefines);$(NMakePreprocessorDefinitions)</NMakePreprocessorDefinitions>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <ForcedIncludeFiles>$(OpenCEUcrtTimeHeader);%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <AdditionalIncludeDirectories>
        $(OpenCEIncludeDirs);
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>$(OpenCEDefines);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="**\*.c">
      <CompileAs>CompileAsC</CompileAs>
    </ClCompile>
    <ClCompile Include="**\*.cpp">
      <CompileAs>CompileAsCpp</CompileAs>
    </ClCompile>
    <ClInclude Include="**\*.h;**\*.hpp;**\*.inc"/>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>